+// sh3vita: GLSL pair -> serialized vertex and fragment programs (the format of vglGetShaderBinary, loaded back with
+// glShaderBinary), without any sceGxm call or GL state, so a background thread can run it while the GL thread draws.
+// The caller must make sure no other thread translates or compiles shaders at the same time.
+extern GLboolean glsl_offline_pair;
+static int sh3_offline_compile(shader *s) {
+	s->prog = shark_compile_shader_extended((const char *)s->source, &s->size, s->type == GL_FRAGMENT_SHADER ? SHARK_FRAGMENT_SHADER : SHARK_VERTEX_SHADER, compiler_opts, compiler_fastmath, compiler_fastprecision, compiler_fastint);
+	if (!s->prog) {
+		shark_clear_output();
+		return 0;
+	}
+	SceGxmProgram *res = (SceGxmProgram *)vglMalloc(s->size);
+	vgl_fast_memcpy((void *)res, (void *)s->prog, s->size);
+	s->prog = res;
+	SceShaccCgCompileOutput *cout = (SceShaccCgCompileOutput *)shark_get_internal_compile_output();
+	SceShaccCgParameter param = sceShaccCgGetFirstParameter(cout);
+	while (param) {   // matrix uniforms: serialize_shader stores their indices
+		if (sceShaccCgGetParameterClass(param) == SCE_SHACCCG_PARAMETERCLASS_MATRIX) {
+			matrix_uniform *m = (matrix_uniform *)vglMalloc(sizeof(matrix_uniform));
+			m->ptr = sceGxmProgramFindParameterByName(s->prog, sceShaccCgGetParameterName(param));
+			m->chain = s->mat;
+			s->mat = m;
+		}
+		param = sceShaccCgGetNextParameter(param);
+	}
+	shark_clear_output();
+	return 1;
+}
+static void sh3_offline_free(shader *s) {
+	matrix_uniform *m = s->mat;
+	while (m) {
+		matrix_uniform *next = (matrix_uniform *)m->chain;
+		vgl_free(m);
+		m = next;
+	}
+	if (s->prog)
+		vgl_free((void *)s->prog);
+	if (s->source)
+		vgl_free(s->source);
+}
+int vglCompileGlslPairToBinary(const char *vs_src, const char *fs_src, void **vbin, uint32_t *vsz, void **fbin, uint32_t *fsz) {
+	*vbin = *fbin = NULL;
+	if (!is_shark_online && !start_shader_compiler())
+		return 0;
+	shader v, f;
+	vgl_memset(&v, 0, sizeof(v));
+	vgl_memset(&f, 0, sizeof(f));
+	v.type = GL_VERTEX_SHADER;
+	f.type = GL_FRAGMENT_SHADER;
+	v.is_glsl = f.is_glsl = GL_TRUE;
+	v.size = strlen(vs_src);
+	f.size = strlen(fs_src);
+	v.source = (char *)vglMalloc(v.size + 1);
+	f.source = (char *)vglMalloc(f.size + 1);
+	vgl_fast_memcpy(v.source, vs_src, v.size + 1);
+	vgl_fast_memcpy(f.source, fs_src, f.size + 1);
+	glsl_offline_pair = GL_TRUE;   // as glLinkProgram does with VGL_MODE_SHADER_PAIR, without changing the global mode
+	glsl_translator_set_process(&v, &f);
+	glsl_offline_pair = GL_FALSE;
+	int ok = sh3_offline_compile(&v) && sh3_offline_compile(&f);
+	if (ok) {
+		size_t a, b;
+		*vbin = serialize_shader(NULL, &a, &v, GL_FALSE);
+		*fbin = serialize_shader(NULL, &b, &f, GL_FALSE);
+		*vsz = (uint32_t)a;
+		*fsz = (uint32_t)b;
+	}
+	sh3_offline_free(&v);
+	sh3_offline_free(&f);
+	return ok;
+}
