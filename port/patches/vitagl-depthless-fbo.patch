+// sh3vita: framebuffer scenes begun without a depth/stencil surface (no forced load/store) while the app says the next
+// draws do not need depth (vglSetFboDepthless). A depthless scene is restarted when depth becomes needed.
+static GLboolean vgl_fbo_depthless = GL_FALSE, scene_depthless = GL_FALSE;
+void vglSetFboDepthless(GLboolean v) {
+	if (v == vgl_fbo_depthless) return;
+	vgl_fbo_depthless = v;
+	if (!v && scene_depthless) dirty_framebuffer = GL_TRUE;
+}
 
